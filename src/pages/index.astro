---
import Base from '../layouts/Base.astro';
---
<Base title="Booking, embedded">
  <main style="max-width:560px;margin:0 auto;padding:4rem 1.5rem;">
    <h1 style="font-size:2rem;font-weight:700;line-height:1.2;margin-bottom:1rem;">
      Booking that fits<br />anywhere.
    </h1>
    <p style="color:#6B7280;margin-bottom:2rem;">
      One link. One embed. iCloud + Google Meet included.
    </p>
    <a href="/signup" style="display:inline-block;background:#2563EB;color:#fff;padding:0.65rem 1.4rem;border-radius:8px;font-weight:600;">
      Get started free
    </a>
  </main>
</Base>
