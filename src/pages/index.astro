---
import Base from '../layouts/Base.astro';
---
<Base title="Booking, embedded">
  <div class="page">

    <nav class="nav">
      <span class="nav-logo">Slotted</span>
      <div class="nav-right">
        <a href="/login" class="nav-login">Log in</a>
        <a href="/signup" class="btn-primary">Get started free</a>
      </div>
    </nav>

    <main>
      <section class="hero">
        <div class="hero-kicker">Booking, simplified</div>
        <h1>Your clients book.<br /><span class="accent">You get a reminder.</span></h1>
        <p class="hero-sub">One link or one embed. Syncs with iCloud Calendar. Google Meet included. No monthly fee to get started.</p>
        <div class="hero-cta">
          <a href="/signup" class="btn-primary btn-lg">Get started free</a>
          <a href="/book?s=demo" class="btn-ghost btn-lg">See a live demo →</a>
        </div>
      </section>

      <section class="how">
        <div class="steps">
          <div class="step">
            <div class="step-num">1</div>
            <h3>Connect your calendar</h3>
            <p>Enter your Apple ID and an app password. Slotted reads your busy times and blocks them automatically.</p>
          </div>
          <div class="step">
            <div class="step-num">2</div>
            <h3>Share your link</h3>
            <p>Send <code>slotted.de/book?s=yourname</code> to a client or embed the booking widget on your site with one line of code.</p>
          </div>
          <div class="step">
            <div class="step-num">3</div>
            <h3>Get a reminder</h3>
            <p>Client books, you get an email with all the details and a calendar invite. Nothing to manage.</p>
          </div>
        </div>
      </section>

      <section class="features">
        <div class="feature-grid">
          <div class="feature">
            <div class="feature-icon">📅</div>
            <h4>iCloud sync</h4>
            <p>Reads your existing calendar. No double bookings.</p>
          </div>
          <div class="feature">
            <div class="feature-icon">🎥</div>
            <h4>Google Meet</h4>
            <p>Clients choose phone or Meet. Link is generated automatically.</p>
          </div>
          <div class="feature">
            <div class="feature-icon">🔗</div>
            <h4>Embeddable</h4>
            <p>One iframe. Fits any website, portfolio, or landing page.</p>
          </div>
          <div class="feature">
            <div class="feature-icon">✉️</div>
            <h4>Auto confirmations</h4>
            <p>Client and you both get an email with a .ics invite attached.</p>
          </div>
          <div class="feature">
            <div class="feature-icon">❌</div>
            <h4>Cancellation link</h4>
            <p>Every confirmation includes a cancel link. No back-and-forth.</p>
          </div>
          <div class="feature">
            <div class="feature-icon">⚙️</div>
            <h4>Your schedule</h4>
            <p>Set your hours, buffer time, lead time, and blackout dates.</p>
          </div>
        </div>
      </section>

      <section class="cta-bottom">
        <h2>Ready in five minutes.</h2>
        <p>No credit card. No sales call. Just a link.</p>
        <a href="/signup" class="btn-primary btn-lg">Create your booking page</a>
      </section>
    </main>

    <footer class="footer">
      <span>© 2026 Slotted</span>
      <a href="/login">Log in</a>
    </footer>
  </div>
</Base>

<style>
  .page { min-height: 100vh; display: flex; flex-direction: column; }

  /* Nav */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    border-bottom: 1px solid #E5E7EB;
  }
  .nav-logo { font-size: 1.05rem; font-weight: 700; letter-spacing: -0.02em; }
  .nav-right { display: flex; align-items: center; gap: 1.25rem; }
  .nav-login { font-size: 0.875rem; color: #6B7280; }
  .nav-login:hover { color: #0D0D0D; }

  /* Buttons */
  .btn-primary {
    display: inline-block;
    background: #2563EB;
    color: #fff;
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background 0.15s;
  }
  .btn-primary:hover { background: #1D4ED8; }
  .btn-ghost {
    display: inline-block;
    color: #374151;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .btn-ghost:hover { color: #0D0D0D; }
  .btn-lg { padding: 0.75rem 1.5rem; font-size: 1rem; }

  /* Hero */
  .hero {
    max-width: 680px;
    margin: 0 auto;
    padding: 5rem 2rem 4rem;
    text-align: center;
  }
  .hero-kicker {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #2563EB;
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }
  .accent { color: #2563EB; }
  .hero-sub {
    font-size: 1.05rem;
    color: #6B7280;
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto 2rem;
  }
  .hero-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; align-items: center; }

  /* How it works */
  .how {
    background: #F9FAFB;
    border-top: 1px solid #E5E7EB;
    border-bottom: 1px solid #E5E7EB;
    padding: 4rem 2rem;
  }
  .steps {
    max-width: 860px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2.5rem;
  }
  .step { }
  .step-num {
    width: 2rem;
    height: 2rem;
    background: #2563EB;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0.9rem;
  }
  .step h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; }
  .step p { font-size: 0.875rem; color: #6B7280; line-height: 1.6; }
  .step code { font-family: monospace; font-size: 0.8rem; background: #E5E7EB; padding: 0.1rem 0.3rem; border-radius: 4px; }

  /* Features */
  .features { padding: 4rem 2rem; }
  .feature-grid {
    max-width: 860px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }
  .feature { }
  .feature-icon { font-size: 1.4rem; margin-bottom: 0.6rem; }
  .feature h4 { font-size: 0.95rem; font-weight: 600; margin-bottom: 0.35rem; }
  .feature p { font-size: 0.85rem; color: #6B7280; line-height: 1.6; }

  /* Bottom CTA */
  .cta-bottom {
    background: #0D0D0D;
    color: #fff;
    text-align: center;
    padding: 4rem 2rem;
  }
  .cta-bottom h2 { font-size: 1.75rem; font-weight: 700; margin-bottom: 0.5rem; }
  .cta-bottom p { color: #9CA3AF; margin-bottom: 1.75rem; }
  .cta-bottom .btn-primary { background: #2563EB; }
  .cta-bottom .btn-primary:hover { background: #1D4ED8; }

  /* Footer */
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    border-top: 1px solid #E5E7EB;
    font-size: 0.8rem;
    color: #9CA3AF;
    margin-top: auto;
  }
  .footer a { color: #9CA3AF; }
  .footer a:hover { color: #0D0D0D; }
</style>
