---
import Base from '../layouts/Base.astro';
---
<Base title="Log in">
  <div class="auth-wrap">
    <div class="auth-card">
      <div class="auth-top">
        <h1 class="auth-title" id="auth-title">Welcome back</h1>
        <div class="lang-toggle">
          <button class="lang-btn" data-lang="en">EN</button>
          <button class="lang-btn" data-lang="de">DE</button>
        </div>
      </div>
      <p class="auth-sub" id="auth-sub">Log in to your Slotted account.</p>

      <form class="auth-form" id="login-form">
        <div class="field">
          <label for="email" id="label-email">Email</label>
          <input id="email" type="email" placeholder="you@example.com" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="password" id="label-password">Password</label>
          <input id="password" type="password" placeholder="Your password" required />
        </div>
        <div id="error-msg" class="error-msg" style="display:none"></div>
        <button type="submit" class="btn-primary" id="submit-btn">Log in</button>
      </form>

      <p class="auth-footer" id="auth-footer">No account yet? <a href="/signup" id="footer-link">Sign up free</a></p>
    </div>
  </div>
</Base>

<style>
  .auth-wrap {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }
  .auth-card { width: 100%; max-width: 400px; }
  .auth-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 0.25rem; }
  .auth-title { font-size: 1.5rem; font-weight: 700; }
  .lang-toggle { display: flex; gap: 0.25rem; margin-top: 0.4rem; }
  .lang-btn { background: none; border: 1px solid #D1D5DB; color: #6B7280; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.03em; cursor: pointer; padding: 0.2rem 0.5rem; border-radius: 5px; font-family: inherit; transition: all 0.1s; }
  .lang-btn:hover { border-color: #9CA3AF; color: #374151; }
  .lang-btn.active { border-color: #2563EB; color: #2563EB; background: #EFF6FF; }
  .auth-sub { color: #6B7280; margin-bottom: 2rem; font-size: 0.9rem; }
  .auth-form { display: flex; flex-direction: column; gap: 1rem; }
  .field { display: flex; flex-direction: column; gap: 0.35rem; }
  .field label { font-size: 0.85rem; font-weight: 500; }
  .field input {
    border: 1px solid #D1D5DB; border-radius: 8px;
    padding: 0.6rem 0.75rem; font-size: 0.95rem; font-family: inherit;
    outline: none; transition: border-color 0.15s;
  }
  .field input:focus { border-color: #2563EB; }
  .btn-primary {
    background: #2563EB; color: #fff; border: none; border-radius: 8px;
    padding: 0.7rem; font-size: 0.95rem; font-weight: 600; font-family: inherit;
    cursor: pointer; margin-top: 0.5rem; transition: background 0.15s;
  }
  .btn-primary:hover { background: #1D4ED8; }
  .btn-primary:disabled { opacity: 0.6; cursor: default; }
  .error-msg {
    background: #FEF2F2; color: #DC2626; border-radius: 8px;
    padding: 0.6rem 0.75rem; font-size: 0.85rem;
  }
  .auth-footer { margin-top: 1.5rem; text-align: center; font-size: 0.875rem; color: #6B7280; }
  .auth-footer a { color: #2563EB; font-weight: 500; }
</style>

<script>
  const T = {
    en: {
      title:       'Welcome back',
      sub:         'Log in to your Slotted account.',
      labelEmail:  'Email',
      labelPw:     'Password',
      submit:      'Log in',
      submitting:  'Logging in…',
      error:       'Invalid email or password.',
      footer:      'No account yet?',
      footerLink:  'Sign up free',
      pwPh:        'Your password',
    },
    de: {
      title:       'Willkommen zurück',
      sub:         'Meld dich in deinem Slotted-Konto an.',
      labelEmail:  'E-Mail',
      labelPw:     'Passwort',
      submit:      'Anmelden',
      submitting:  'Anmeldung läuft…',
      error:       'E-Mail oder Passwort ungültig.',
      footer:      'Noch kein Konto?',
      footerLink:  'Kostenlos registrieren',
      pwPh:        'Dein Passwort',
    },
  };

  type Lang = 'en' | 'de';
  const stored = localStorage.getItem('sl_lang') as Lang | null;
  const browser = (navigator.language || 'en').toLowerCase().startsWith('de') ? 'de' : 'en';
  let lang: Lang = stored ?? browser;

  const btn    = document.getElementById('submit-btn') as HTMLButtonElement;
  const err    = document.getElementById('error-msg') as HTMLDivElement;
  const pwInput = document.getElementById('password') as HTMLInputElement;

  function applyLang() {
    const t = T[lang];
    const s = (id: string, val: string) => { const el = document.getElementById(id); if (el) el.textContent = val; };
    s('auth-title',    t.title);
    s('auth-sub',      t.sub);
    s('label-email',   t.labelEmail);
    s('label-password', t.labelPw);
    s('submit-btn',    t.submit);
    s('footer-link',   t.footerLink);
    (document.getElementById('auth-footer') as HTMLElement).childNodes[0].textContent = t.footer + ' ';
    pwInput.placeholder = t.pwPh;
    document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.lang === lang);
    });
    localStorage.setItem('sl_lang', lang);
  }

  applyLang();

  document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach(b => {
    b.addEventListener('click', () => { lang = b.dataset.lang as Lang; applyLang(); });
  });

  document.getElementById('login-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = T[lang].submitting;
    err.style.display = 'none';

    const email    = (document.getElementById('email') as HTMLInputElement).value;
    const password = pwInput.value;

    try {
      const res  = await fetch(`${window.SL_API}/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ email, password }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || T[lang].error);
      localStorage.setItem('sl_token', data.token);
      localStorage.setItem('sl_name', data.user?.name ?? '');
      window.location.href = '/dashboard';
    } catch (e: any) {
      err.textContent    = e.message;
      err.style.display  = 'block';
      btn.disabled       = false;
      btn.textContent    = T[lang].submit;
    }
  });
</script>
