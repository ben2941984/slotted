---
import Base from '../layouts/Base.astro';
---
<Base title="Dashboard">
  <div class="shell">
    <nav class="sidebar">
      <div class="sidebar-logo">Slotted</div>
      <ul class="sidebar-nav">
        <li><a href="/dashboard" class="active" id="nav-bookings">Bookings</a></li>
        <li><a href="/dashboard/settings" id="nav-settings">Settings</a></li>
      </ul>
      <div class="lang-toggle" id="lang-toggle">
        <button class="lang-btn active" data-lang="en">EN</button>
        <button class="lang-btn" data-lang="de">DE</button>
      </div>
      <button class="logout-btn" id="logout-btn">Log out</button>
    </nav>

    <main class="main">
      <header class="main-header">
        <h1 id="page-title">Bookings</h1>
        <div class="header-right">
          <span class="booking-link" id="booking-link"></span>
        </div>
      </header>

      <div id="embed-panel" style="display:none">
        <div class="embed-box">
          <div class="embed-header">
            <div>
              <div class="embed-label">Your booking link</div>
              <a class="embed-link" id="embed-link" target="_blank" rel="noopener"></a>
            </div>
            <button class="embed-toggle" id="embed-toggle">Show embed snippet ↓</button>
          </div>
          <div id="embed-snippet" style="display:none">
            <div class="embed-snippet-label" id="embed-snippet-label">Paste this on your website</div>
            <pre id="embed-code" class="embed-code"></pre>
            <button class="copy-btn" id="copy-btn">Copy</button>
          </div>
        </div>
      </div>

      <div id="bookings-wrap">
        <div class="empty-state" id="empty-state" style="display:none">
          No bookings yet. Share your booking link to get started.
        </div>
        <table class="bookings-table" id="bookings-table" style="display:none">
          <thead>
            <tr>
              <th id="th-datetime">Date &amp; time</th>
              <th id="th-name">Name</th>
              <th id="th-email">Email</th>
              <th id="th-type">Type</th>
              <th id="th-status">Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="bookings-body"></tbody>
        </table>
      </div>
    </main>
  </div>
</Base>

<style is:global>
  .shell { display: flex; min-height: 100vh; }

  .sidebar {
    width: 220px;
    flex-shrink: 0;
    background: #0D0D0D;
    color: #fff;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    gap: 0.5rem;
  }
  .sidebar-logo {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    padding: 0 0.5rem;
    margin-bottom: 1.5rem;
  }
  .sidebar-nav { list-style: none; display: flex; flex-direction: column; gap: 0.25rem; flex: 1; }
  .sidebar-nav a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-size: 0.875rem;
    color: #9CA3AF;
    transition: background 0.1s, color 0.1s;
  }
  .sidebar-nav a:hover, .sidebar-nav a.active {
    background: rgba(255,255,255,0.08);
    color: #fff;
  }
  .logout-btn {
    background: none;
    border: none;
    color: #6B7280;
    font-size: 0.8rem;
    font-family: inherit;
    cursor: pointer;
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    transition: color 0.1s;
  }
  .logout-btn:hover { color: #fff; }

  .main { flex: 1; display: flex; flex-direction: column; }
  .main-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid #E5E7EB;
  }
  .main-header h1 { font-size: 1.1rem; font-weight: 600; }
  .booking-link {
    font-size: 0.8rem;
    color: #6B7280;
    background: #F3F4F6;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    font-family: monospace;
  }

  #bookings-wrap { padding: 1.5rem 2rem; }
  .empty-state {
    color: #6B7280;
    font-size: 0.9rem;
    padding: 3rem 0;
    text-align: center;
  }
  .bookings-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    font-family: "Inter Variable", system-ui, sans-serif;
  }
  .bookings-table th {
    text-align: left;
    padding: 0.6rem 1rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: #9CA3AF;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid #E5E7EB;
  }
  .bookings-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid #F3F4F6;
    vertical-align: middle;
    color: #111827;
  }
  .bookings-table tr:last-child td { border-bottom: none; }
  .bookings-table tbody tr:hover td { background: #F9FAFB; }
  .booking-date { font-weight: 500; white-space: nowrap; }
  .booking-email { color: #6B7280; }
  .booking-type { color: #6B7280; }
  .status-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 99px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .status-confirmed { background: #DCFCE7; color: #15803D; }
  .status-cancelled { background: #FEF2F2; color: #DC2626; }
  .cancel-btn {
    font-size: 0.75rem;
    color: #6B7280;
    background: none;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    cursor: pointer;
    font-family: inherit;
    padding: 0.25rem 0.6rem;
    transition: border-color 0.1s, color 0.1s;
  }
  .cancel-btn:hover { border-color: #DC2626; color: #DC2626; }

  .embed-box {
    margin: 1.5rem 2rem 0;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    overflow: hidden;
  }
  .embed-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.25rem;
    background: #F9FAFB;
  }
  .embed-label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #9CA3AF; margin-bottom: 0.2rem; }
  .embed-link { font-size: 0.875rem; color: #2563EB; font-family: monospace; }
  .embed-link:hover { text-decoration: underline; }
  .lang-toggle { display: flex; gap: 0.25rem; padding: 0 0.5rem; margin-top: auto; margin-bottom: 0.5rem; }
  .lang-btn { background: none; border: none; color: #9CA3AF; font-size: 0.75rem; font-family: inherit; font-weight: 600; letter-spacing: 0.04em; cursor: pointer; padding: 0.2rem 0.4rem; border-radius: 4px; transition: color 0.1s; }
  .lang-btn:hover { color: #fff; }
  .lang-btn.active { color: #fff; background: rgba(255,255,255,0.1); }

  .embed-toggle { background: none; border: 1px solid #D1D5DB; border-radius: 6px; padding: 0.35rem 0.75rem; font-size: 0.8rem; font-family: inherit; cursor: pointer; color: #374151; transition: background 0.1s; }
  .embed-toggle:hover { background: #fff; }
  .embed-snippet-label { font-size: 0.75rem; font-weight: 600; color: #9CA3AF; margin-bottom: 0.5rem; }
  #embed-snippet { padding: 1rem 1.25rem; border-top: 1px solid #E5E7EB; }
  .embed-code {
    background: #0D0D0D;
    color: #F8FF3D;
    padding: 0.9rem 1rem;
    border-radius: 8px;
    font-size: 0.78rem;
    font-family: monospace;
    white-space: pre-wrap;
    word-break: break-all;
    margin: 0 0 0.75rem;
  }
  .copy-btn { background: #0D0D0D; color: #fff; border: none; border-radius: 6px; padding: 0.4rem 0.9rem; font-size: 0.8rem; font-family: inherit; cursor: pointer; transition: background 0.1s; }
  .copy-btn:hover { background: #374151; }
</style>

<script>
  const token = localStorage.getItem('sl_token');
  if (!token) window.location.href = '/login';

  // ── i18n ─────────────────────────────────────────────────────────────────
  const DASH_T = {
    en: {
      bookings:       'Bookings',
      settings:       'Settings',
      logout:         'Log out',
      bookingLink:    'Your booking link',
      showSnippet:    'Show embed snippet ↓',
      hideSnippet:    'Hide snippet ↑',
      pasteOnSite:    'Paste this on your website',
      copy:           'Copy',
      copied:         'Copied',
      noBookings:     'No bookings yet. Share your booking link to get started.',
      datetime:       'Date & time',
      name:           'Name',
      email:          'Email',
      type:           'Type',
      status:         'Status',
      cancel:         'Cancel',
      cancelConfirm:  'Cancel this booking?',
      confirmed:      'confirmed',
      cancelled:      'cancelled',
      phone:          'Phone',
    },
    de: {
      bookings:       'Buchungen',
      settings:       'Einstellungen',
      logout:         'Abmelden',
      bookingLink:    'Dein Buchungslink',
      showSnippet:    'Einbetten ↓',
      hideSnippet:    'Ausblenden ↑',
      pasteOnSite:    'Auf deiner Website einbetten',
      copy:           'Kopieren',
      copied:         'Kopiert',
      noBookings:     'Noch keine Buchungen. Teile deinen Buchungslink.',
      datetime:       'Datum & Uhrzeit',
      name:           'Name',
      email:          'E-Mail',
      type:           'Art',
      status:         'Status',
      cancel:         'Stornieren',
      cancelConfirm:  'Buchung stornieren?',
      confirmed:      'bestätigt',
      cancelled:      'storniert',
      phone:          'Telefon',
    },
  };

  type Lang = 'en' | 'de';
  let lang: Lang = (localStorage.getItem('sl_lang') as Lang) || 'en';

  function applyLang() {
    const t = DASH_T[lang];
    const s = (id: string, val: string) => { const el = document.getElementById(id); if (el) el.textContent = val; };
    s('nav-bookings', t.bookings);
    s('nav-settings', t.settings);
    s('logout-btn', t.logout);
    s('page-title', t.bookings);
    s('embed-snippet-label', t.pasteOnSite);
    s('empty-state', t.noBookings);
    s('th-datetime', t.datetime);
    s('th-name', t.name);
    s('th-email', t.email);
    s('th-type', t.type);
    s('th-status', t.status);
    // Toggle buttons
    document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.lang === lang);
    });
  }

  applyLang();

  document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      lang = btn.dataset.lang as Lang;
      localStorage.setItem('sl_lang', lang);
      applyLang();
      loadBookings();
    });
  });

  // ── Slug & embed ─────────────────────────────────────────────────────────
  const slug = localStorage.getItem('sl_slug') || '';
  const linkEl = document.getElementById('booking-link');
  if (linkEl && slug) linkEl.textContent = `slotted.de/book?s=${slug}`;

  let _embedSnippet = '';

  async function buildEmbed() {
    if (!slug) return;
    const t = DASH_T[lang];

    let theme = 'light', layout = 'default';
    try {
      const res = await fetch(`${window.SL_API}/settings`, {
        headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/json' },
      });
      const s = await res.json();
      theme  = s.embed_theme  ?? 'light';
      layout = s.embed_layout ?? 'default';
    } catch {}

    const params = new URLSearchParams({ s: slug });
    if (theme  !== 'light')   params.set('theme',  theme);
    if (layout !== 'default') params.set('layout', layout);
    if (lang   !== 'en')      params.set('lang',   lang);

    const bookUrl = `https://slotted.de/book?${params}`;
    const height  = layout === 'mini' ? '420' : '600';
    const radius  = layout === 'mini' ? '10px' : '12px';
    _embedSnippet = `<iframe\n  src="${bookUrl}"\n  width="100%"\n  height="${height}"\n  frameborder="0"\n  style="border-radius:${radius};border:1px solid #e5e7eb"\n></iframe>`;

    const panel = document.getElementById('embed-panel') as HTMLElement;
    panel.style.display = '';

    const linkA = document.getElementById('embed-link') as HTMLAnchorElement;
    linkA.textContent = bookUrl;
    linkA.href = `/book?${params}`;

    const code = document.getElementById('embed-code') as HTMLElement;
    code.textContent = _embedSnippet;

    const toggleBtn = document.getElementById('embed-toggle') as HTMLButtonElement;
    toggleBtn.textContent = t.showSnippet;

    // Re-attach listeners (idempotent via clone)
    const newToggle = toggleBtn.cloneNode(true) as HTMLButtonElement;
    toggleBtn.replaceWith(newToggle);
    newToggle.addEventListener('click', () => {
      const snip = document.getElementById('embed-snippet') as HTMLElement;
      const open = snip.style.display === 'none';
      snip.style.display = open ? '' : 'none';
      newToggle.textContent = open ? DASH_T[lang].hideSnippet : DASH_T[lang].showSnippet;
    });

    const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
    const newCopy = copyBtn.cloneNode(true) as HTMLButtonElement;
    newCopy.textContent = t.copy;
    copyBtn.replaceWith(newCopy);
    newCopy.addEventListener('click', () => {
      navigator.clipboard.writeText(_embedSnippet);
      newCopy.textContent = DASH_T[lang].copied;
      setTimeout(() => { newCopy.textContent = DASH_T[lang].copy; }, 1500);
    });
  }

  buildEmbed();

  // ── Logout ───────────────────────────────────────────────────────────────
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await fetch(`${window.SL_API}/auth/logout`, {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/json' },
    });
    localStorage.removeItem('sl_token');
    localStorage.removeItem('sl_name');
    localStorage.removeItem('sl_slug');
    window.location.href = '/login';
  });

  // ── Bookings table ───────────────────────────────────────────────────────
  async function loadBookings() {
    const t      = DASH_T[lang];
    const locale = lang === 'de' ? 'de-DE' : 'en-GB';
    try {
      const res = await fetch(`${window.SL_API}/bookings`, {
        headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/json' },
      });
      const data = await res.json();
      const bookings: any[] = data.data ?? data ?? [];

      const emptyEl = document.getElementById('empty-state') as HTMLElement;
      emptyEl.textContent = t.noBookings;

      if (bookings.length === 0) {
        emptyEl.style.display = 'block';
        (document.getElementById('bookings-table') as HTMLElement).style.display = 'none';
        return;
      }

      emptyEl.style.display = 'none';
      const table = document.getElementById('bookings-table') as HTMLElement;
      const tbody = document.getElementById('bookings-body') as HTMLElement;
      table.style.display = 'table';

      tbody.innerHTML = bookings.map((b: any) => {
        const dateStr = new Date(b.start_dt).toLocaleString(locale, { dateStyle: 'short', timeStyle: 'short' })
          + ' – ' + new Date(b.end_dt).toLocaleTimeString(locale, { timeStyle: 'short' });
        const typeStr   = b.is_google_meet ? 'Google Meet' : t.phone;
        const statusStr = b.status === 'confirmed' ? t.confirmed : t.cancelled;
        const cancelBtn = b.status === 'confirmed'
          ? `<button class="cancel-btn" data-id="${b.id}">${t.cancel}</button>` : '';
        return `<tr>
          <td class="booking-date">${dateStr}</td>
          <td>${b.name}</td>
          <td class="booking-email">${b.email}</td>
          <td class="booking-type">${typeStr}</td>
          <td><span class="status-badge status-${b.status}">${statusStr}</span></td>
          <td>${cancelBtn}</td>
        </tr>`;
      }).join('');

      tbody.querySelectorAll<HTMLButtonElement>('.cancel-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (!confirm(DASH_T[lang].cancelConfirm)) return;
          const id = btn.dataset.id;
          await fetch(`${window.SL_API}/bookings/${id}/cancel`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/json' },
          });
          loadBookings();
        });
      });
    } catch {}
  }

  loadBookings();
</script>
