---
interface Props {
  title?: string;
}
const { title = 'Slotted' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Slotted</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
